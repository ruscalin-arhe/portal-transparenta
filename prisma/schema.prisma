generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Sesizare {
  id        String   @id @default(cuid())
  nume      String
  email     String
  telefon   String?
  subiect   String
  mesaj     String
  status    String   @default("noua")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Proiect {
  id                String     @id @default(cuid())
  slug              String     @unique
  nume              String
  status            String
  localitate        String
  valoareText       String
  valoareMil        Float?
  progres           Int        @default(0)
  descriere         String
  dataStart         String?
  dataEstimata      String?
  beneficiar        String?
  categorie         String?
  lat               Float?
  lng               Float?
  published         Boolean    @default(true)
  bugetAlocatMil    Float?
  bugetCheltuitMil  Float?
  depasireBugetMil  Float?
  zileIntarziere    Int        @default(0)
  progresFizic      Int?
  progresFinanciar  Int?
  risc              String?
  sursaFinantare    String?
  contractor        String?
  ultimaActualizare String?
  programCod        String?
  componentaPNRR    String?
  sourceUrl         String?
  sourceRetrievedAt DateTime?
  documente         Document[]
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
}

model Document {
  id         String   @id @default(cuid())
  titlu      String
  tip        String
  data       String?
  dimensiune String?
  url        String
  published  Boolean  @default(true)
  proiectId  String?
  proiect    Proiect? @relation(fields: [proiectId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model PnrrPlata {
  dataRunId         String?
  dataRun           DataRun?  @relation(fields: [dataRunId], references: [id], onDelete: SetNull)
  id                String   @id @default(cuid())
  componenta        String?
  investitie        String?
  beneficiar        String?
  suma              Float?
  moneda            String?  @default("RON")
  dataPlata         String?
  judet             String?
  rawJson           String?
  sourceUrl         String
  sourceFile        String?
  retrievedAt       DateTime @default(now())
  createdAt         DateTime @default(now())

  dataStatus        String   @default("MISSING_DATA")
  completenessScore Int      @default(0)
  validationReport  String?
  published         Boolean  @default(false)

  @@index([componenta])
  @@index([judet])
  @@index([dataStatus])
  @@index([published])
  @@index([dataRunId])
}

model PageView {
  id        String   @id @default(cuid())
  path      String
  method    String   @default("GET")
  status    Int?
  ip        String?
  country   String?
  city      String?
  referer   String?
  userAgent String?
  isAdmin   Boolean  @default(false)
  userId    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([path])
  @@index([isAdmin])
  @@index([country])
}


enum Channel {
  PUBLIC
  PRIVATE
}

model Organization {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  shortName   String?
  type        String?
  website     String?
  description String?
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  dataSources DataSource[]
}

model DataSource {
  id             String       @id @default(cuid())
  slug           String       @unique
  name           String
  description    String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  type           String
  sourceUrl      String?
  channel        Channel      @default(PUBLIC)
  frequency      String?
  active         Boolean      @default(true)
  lastRunAt      DateTime?
  published      Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  runs           DataRun[]
}

model DataRun {
  id           String     @id @default(cuid())
  dataSourceId String
  dataSource   DataSource @relation(fields: [dataSourceId], references: [id], onDelete: Cascade)
  status       String
  startedAt    DateTime
  finishedAt   DateTime?
  recordsTotal Int?
  recordsOk    Int?
  recordsError Int?
  sourceFile   String?
  sourceUrl    String?
  errorLog     String?
  metadata     Json?
  createdAt    DateTime   @default(now())
  pnrrPlati    PnrrPlata[]
  tenders      Tender[]
}

model Tender {
  id                   String    @id @default(cuid())
  dataRunId            String?
  dataRun              DataRun?  @relation(fields: [dataRunId], references: [id], onDelete: SetNull)

  externalId           String?
  title                String
  cpvCodes             String[]  @default([])
  cpvMain              String?
  valueEstimated       Float?
  valueCurrency        String?   @default("RON")
  contractingAuthority String?
  status               String?
  publicationDate      DateTime?
  deadline             DateTime?
  procedureType        String?
  sourceUrl            String
  sourceFile           String?
  rawJson              String?

  published            Boolean   @default(false)
  retrievedAt          DateTime  @default(now())
  createdAt            DateTime  @default(now())

  @@index([cpvMain])
  @@index([status])
  @@index([published])
  @@index([dataRunId])
  @@index([publicationDate])
  @@index([externalId])
}

