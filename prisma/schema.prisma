generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Sesizare {
  id        String   @id @default(cuid())
  nume      String
  email     String
  telefon   String?
  subiect   String
  mesaj     String
  status    String   @default("noua")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Proiect {
  id                String     @id @default(cuid())
  slug              String     @unique
  nume              String
  status            String
  localitate        String
  valoareText       String
  valoareMil        Float?
  progres           Int        @default(0)
  descriere         String
  dataStart         String?
  dataEstimata      String?
  beneficiar        String?
  categorie         String?
  lat               Float?
  lng               Float?
  published         Boolean    @default(true)
  bugetAlocatMil    Float?
  bugetCheltuitMil  Float?
  depasireBugetMil  Float?
  zileIntarziere    Int        @default(0)
  progresFizic      Int?
  progresFinanciar  Int?
  risc              String?
  sursaFinantare    String?
  contractor        String?
  ultimaActualizare String?
  programCod        String?
  componentaPNRR    String?
  sourceUrl         String?
  sourceRetrievedAt DateTime?
  documente         Document[]
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
}

model Document {
  id         String   @id @default(cuid())
  titlu      String
  tip        String
  data       String?
  dimensiune String?
  url        String
  published  Boolean  @default(true)
  proiectId  String?
  proiect    Proiect? @relation(fields: [proiectId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model PnrrPlata {
  id          String   @id @default(cuid())
  componenta  String?
  investitie  String?
  beneficiar  String?
  suma        Float?
  moneda      String?  @default("RON")
  dataPlata   String?
  judet       String?
  rawJson     String?
  sourceUrl   String
  sourceFile  String?
  retrievedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([componenta])
  @@index([judet])
}
